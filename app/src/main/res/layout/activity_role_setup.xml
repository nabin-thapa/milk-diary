<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/background"
    android:padding="32dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="App Icon"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Milk Diary"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:paddingBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dairy Management System"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:paddingBottom="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Who are you?"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:paddingBottom="24dp" />

    <Button
        android:id="@+id/btnOwner"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="👑  I am the Owner"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/primary"
        app:cornerRadius="14dp"
        android:stateListAnimator="@null"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnSalesman"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="🛒  I am a Salesman"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/accent"
        app:cornerRadius="14dp"
        android:stateListAnimator="@null"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This can be changed later in Settings."
        android:textSize="12sp"
        android:textColor="@color/text_hint"
        android:gravity="center" />

</LinearLayout>
