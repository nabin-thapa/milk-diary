<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/ToolbarStyle"
        app:title="Payment Tracking" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="28dp">

            <!-- Tabs: Customer / Supplier -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_spinner">

                <TextView
                    android:id="@+id/tabCustomerPayments"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="💰  From Customers"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/primary"
                    android:padding="10dp" />

                <TextView
                    android:id="@+id/tabSupplierPayments"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="📤  To Suppliers"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@color/card_bg"
                    android:padding="10dp" />
            </LinearLayout>

            <!-- Balance hero card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/primary">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SUMMARY"
                        android:textColor="#B0FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        android:paddingBottom="4dp" />
                    <TextView
                        android:id="@+id/tvPendingAmt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending: Rs. 0.00"
                        android:textColor="#FDE68A"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:paddingBottom="16dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#33FFFFFF" android:layout_marginBottom="16dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Earnings" android:textColor="#B0FFFFFF" android:textSize="13sp" />
                        <TextView android:id="@+id/tvTotalEarned" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rs. 0.00" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Paid" android:textColor="#B0FFFFFF" android:textSize="13sp" />
                        <TextView android:id="@+id/tvTotalPaid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rs. 0.00" android:textColor="#BBF7D0" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Supplier Section (hidden when on Customer tab) -->
            <LinearLayout
                android:id="@+id/supplierSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select Supplier"
                    style="@style/InputField"
                    android:layout_marginBottom="12dp"
                    app:endIconMode="dropdown_menu">
                    <AutoCompleteTextView
                        android:id="@+id/etPaySupplier"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textSize="16sp"
                        android:focusable="false"
                        android:clickable="true" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Record Payment -->
            <TextView
                android:id="@+id/labelRecordPayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RECORD PAYMENT"
                style="@style/SectionLabel" />

            <androidx.cardview.widget.CardView
                android:id="@+id/sectionRecordPayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/card_bg">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <Button
                        android:id="@+id/btnPayDate"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="14dp"
                        android:text="📅  Select Date"
                        android:backgroundTint="@color/primary_light"
                        android:textColor="@color/primary_dark"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        app:cornerRadius="12dp"
                        android:stateListAnimator="@null" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Amount (Rs)"
                        style="@style/InputField">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPayAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:selectAllOnFocus="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="Note (optional)"
                        style="@style/InputField">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPayNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnAddPayment"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="＋  Add Payment"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/accent"
                        app:cornerRadius="14dp"
                        android:stateListAnimator="@null" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Payment History -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PAYMENT HISTORY"
                style="@style/SectionLabel" />

            <TextView
                android:id="@+id/tvNoPayments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No payments recorded yet."
                android:gravity="center"
                android:padding="28dp"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPayments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
